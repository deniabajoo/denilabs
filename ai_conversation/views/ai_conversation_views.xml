<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_conversation_list" model="ir.ui.view">
        <field name="name">ai.conversation.list</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <list string="AI Conversations">
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'processing'" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_ai_conversation_form" model="ir.ui.view">
        <field name="name">ai.conversation.form</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <form string="AI Conversation">
                <header>
                    <button name="action_start_processing" string="Start Processing" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Conversation Title..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="audio_file" filename="audio_filename" invisible="gdrive_link != False"/>
                            <field name="audio_filename" invisible="1"/>
                            <field name="gdrive_link" invisible="audio_file != False"/>
                            <field name="job_id" invisible="state == 'draft'"/>
                        </group>
                        <group>
                            <field name="lead_id" invisible="not lead_id"/>
                            <field name="project_task_id" invisible="not project_task_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Action Items">
                            <field name="action_item_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="assignee_name"/>
                                    <field name="deadline"/>
                                    <field name="is_completed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary">
                            <field name="summary" nolabel="1"/>
                        </page>
                        <page string="Raw Transcript">
                            <field name="raw_transcript" nolabel="1"/>
                        </page>
                        <page string="Speakers Dialogue">
                            <field name="speaker_ids">
                                <list editable="bottom">
                                    <field name="timestamp_start"/>
                                    <field name="speaker_name"/>
                                    <field name="text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_ai_conversation" model="ir.actions.act_window">
        <field name="name">AI Conversations</field>
        <field name="res_model">ai.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_conversation_root" name="AI Intelligence" sequence="10"/>
    <menuitem id="menu_ai_conversation" name="Conversations" parent="menu_ai_conversation_root" action="action_ai_conversation" sequence="10"/>
</odoo>
