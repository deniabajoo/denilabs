<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- res.partner: Inherit Form View — Smart Button Vendor Score -->
    <!-- ============================================================ -->
    <record id="res_partner_form_inherit_vendor_scoring" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.vendor.scoring</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vendor_scores"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bar-chart"
                        invisible="supplier_rank == 0 or vendor_score_count == 0">
                    <field name="vendor_score_count" string="Riwayat Skor" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
