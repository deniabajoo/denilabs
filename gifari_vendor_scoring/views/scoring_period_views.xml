<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Scoring Period: List View -->
    <!-- ============================================================ -->
    <record id="view_scoring_period_list" model="ir.ui.view">
        <field name="name">scoring.period.list</field>
        <field name="model">scoring.period</field>
        <field name="arch" type="xml">
            <list string="Periode Evaluasi"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'scoring'"
                  decoration-success="state == 'validated'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="evaluator_id" widget="many2one_avatar_user"/>
                <field name="vendor_count"/>
                <field name="total_weight"
                       decoration-danger="not is_weight_valid"
                       decoration-success="is_weight_valid"/>
                <field name="is_weight_valid" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'scoring'"
                       decoration-success="state in ('calculated', 'validated')"
                       decoration-danger="state == 'cancelled'"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Scoring Period: Kanban View -->
    <!-- ============================================================ -->
    <record id="view_scoring_period_kanban" model="ir.ui.view">
        <field name="name">scoring.period.kanban</field>
        <field name="model">scoring.period</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false" sample="1">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <strong><field name="name"/></strong>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'scoring'"
                                   decoration-success="state in ('calculated', 'validated')"
                                   decoration-danger="state == 'cancelled'"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-calendar" title="Periode"/> <field name="date_from"/> — <field name="date_to"/>
                        </div>
                        <div class="mb-1">
                            <span class="badge rounded-pill text-bg-primary">
                                <i class="fa fa-users" title="Pemasok"/> <field name="vendor_count"/> pemasok
                            </span>
                        </div>
                        <div t-if="record.score_total_count.raw_value > 0" class="mb-1">
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar"
                                     t-attf-style="width: #{record.scoring_progress_percent.raw_value}%;"
                                     t-att-class="{'bg-success': record.score_filled_count.raw_value == record.score_total_count.raw_value, 'bg-warning': record.score_filled_count.raw_value != record.score_total_count.raw_value}"/>
                            </div>
                            <small class="text-muted">
                                <field name="score_filled_count"/>/<field name="score_total_count"/> skor terisi
                            </small>
                        </div>
                        <div t-attf-class="mb-1 #{record.is_weight_valid.raw_value ? 'text-success' : 'text-danger'}">
                            <i t-attf-class="fa #{record.is_weight_valid.raw_value ? 'fa-check-circle' : 'fa-exclamation-triangle'}" title="Status Bobot"/>
                            Bobot: <field name="total_weight"/>%
                        </div>
                        <div t-if="record.top_vendor_name.value" class="mb-1">
                            <span class="badge rounded-pill text-bg-warning">
                                <i class="fa fa-trophy me-1" title="Vendor Terbaik" aria-hidden="true"/><field name="top_vendor_name"/>
                            </span>
                        </div>
                        <div class="mt-2">
                            <field name="evaluator_id" widget="many2one_avatar_user"/>
                        </div>
                        <field name="is_weight_valid" invisible="1"/>
                        <field name="scoring_progress_percent" invisible="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Scoring Period: Calendar View -->
    <!-- ============================================================ -->
    <record id="view_scoring_period_calendar" model="ir.ui.view">
        <field name="name">scoring.period.calendar</field>
        <field name="model">scoring.period</field>
        <field name="arch" type="xml">
            <calendar date_start="date_from" date_stop="date_to" color="state" mode="month">
                <field name="name"/>
                <field name="evaluator_id" widget="many2one_avatar_user"/>
                <field name="vendor_count"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Scoring Period: Form View -->
    <!-- ============================================================ -->
    <record id="view_scoring_period_form" model="ir.ui.view">
        <field name="name">scoring.period.form</field>
        <field name="model">scoring.period</field>
        <field name="arch" type="xml">
            <form string="Periode Evaluasi">
                <header>
                    <!-- Tombol aksi berdasarkan state -->
                    <button name="action_start_scoring"
                            string="Mulai Penilaian"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or not is_ready_to_start"
                            confirm="Memulai penilaian untuk pemasok yang dipilih. Lanjutkan?"/>
                    <!-- Placeholder non-aktif: kesiapan periode belum terpenuhi -->
                    <button string="Mulai Penilaian"
                            class="btn-secondary"
                            disabled="1"
                            invisible="state != 'draft' or is_ready_to_start"
                            title="Lengkapi kesiapan periode dulu: tanggal terisi, bobot kriteria 100%, dan minimal 2 pemasok dipilih."/>
                    <button name="action_calculate_saw"
                            string="Hitung SAW"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'scoring'"/>
                    <button name="action_validate"
                            string="Validasi"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'calculated'"
                            groups="gifari_vendor_scoring.group_vendor_scoring_validator"
                            confirm="Memvalidasi hasil evaluasi. Data tidak dapat diubah setelah validasi. Lanjutkan?"/>
                    <button name="action_back_to_scoring"
                            string="Kembali ke Penilaian"
                            type="object"
                            invisible="state != 'calculated'"/>
                    <button name="action_cancel"
                            string="Batalkan"
                            type="object"
                            invisible="state not in ('draft', 'scoring')"
                            confirm="Yakin ingin membatalkan periode evaluasi ini?"/>
                    <button name="action_reset_to_draft"
                            string="Reset ke Draft"
                            type="object"
                            invisible="state != 'cancelled'"
                            groups="gifari_vendor_scoring.group_vendor_scoring_configurator"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scoring,calculated,validated"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vendor_scores"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users"
                                invisible="vendor_count == 0">
                            <field name="vendor_count" string="Vendor Dievaluasi" widget="statinfo"/>
                        </button>
                        <button name="action_view_vendor_scores"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bar-chart"
                                invisible="score_total_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="score_filled_count" class="d-inline"/> / <field name="score_total_count" class="d-inline"/>
                                </span>
                                <span class="o_stat_text">Skor Terisi</span>
                            </div>
                        </button>
                        <button name="action_view_top_vendor"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-trophy"
                                invisible="state not in ('calculated', 'validated')">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="top_score_value" class="d-inline"/>
                                </span>
                                <span class="o_stat_text">Skor Tertinggi</span>
                            </div>
                        </button>
                    </div>
                    <!-- Pita panduan per-status: selalu menjelaskan langkah berikutnya -->
                    <div class="alert alert-info d-flex align-items-center gap-2" role="status"
                         invisible="state != 'draft'">
                        <i class="fa fa-info-circle" title="Panduan" aria-hidden="true"/>
                        <span>Atur periode di bawah — isi tanggal, atur bobot kriteria hingga 100%,
                            dan pilih pemasok — lalu klik <strong>Mulai Penilaian</strong>.</span>
                    </div>
                    <div class="alert alert-info d-flex align-items-center gap-2" role="status"
                         invisible="state != 'scoring'">
                        <i class="fa fa-pencil-square-o" title="Panduan" aria-hidden="true"/>
                        <span>Lengkapi semua skor pada tab <strong>Matrix Penilaian</strong>,
                            lalu klik <strong>Hitung SAW</strong> untuk menghasilkan peringkat.</span>
                    </div>
                    <div class="alert alert-info d-flex align-items-center gap-2" role="status"
                         invisible="state != 'calculated'">
                        <i class="fa fa-trophy" title="Panduan" aria-hidden="true"/>
                        <span>Tinjau tab <strong>Hasil Ranking</strong>, lalu klik
                            <strong>Validasi</strong> untuk mengunci hasil evaluasi.</span>
                    </div>
                    <div class="alert alert-success d-flex align-items-center gap-2" role="status"
                         invisible="state != 'validated'">
                        <i class="fa fa-lock" title="Terkunci" aria-hidden="true"/>
                        <span>Periode ini telah <strong>tervalidasi</strong> dan dikunci.</span>
                    </div>

                    <!-- Banner: bobot belum 100% -->
                    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert"
                         invisible="is_weight_valid or not period_criterion_ids">
                        <i class="fa fa-exclamation-triangle" title="Peringatan" aria-hidden="true"/>
                        <span>
                            <strong>Total bobot kriteria saat ini:
                                <field name="total_weight" class="d-inline"/>%
                            </strong> — harus tepat 100% sebelum memulai penilaian.
                        </span>
                    </div>
                    <!-- Banner: bobot sudah valid (umpan balik positif) -->
                    <div class="alert alert-success d-flex align-items-center gap-2" role="status"
                         invisible="not is_weight_valid or not period_criterion_ids or state != 'draft'">
                        <i class="fa fa-check-circle" title="Valid" aria-hidden="true"/>
                        <span><strong>Bobot kriteria sudah seimbang (100%).</strong> Periode siap untuk dinilai.</span>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="misal: Evaluasi Q1 2026"
                                   readonly="state == 'validated'"/>
                        </h1>
                    </div>

                    <!-- Mode Draft: Full Setup View -->
                    <group invisible="state != 'draft'">
                        <group string="Periode &amp; Personil">
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="evaluator_id" widget="many2one_avatar_user"/>
                            <field name="company_id" invisible="1"/>
                            <field name="is_weight_valid" invisible="1"/>
                            <field name="is_ready_to_start" invisible="1"/>
                        </group>
                        <group string="Paket Kriteria">
                            <field name="package_id" options="{'no_create': True}" readonly="state != 'draft'"
                                   placeholder="Pilih paket untuk mengisi kriteria otomatis…"/>
                            <field name="criterion_count" invisible="1"/>
                            <field name="partner_selected_count" invisible="1"/>
                        </group>
                    </group>

                    <!-- Daftar kesiapan: kriteria go/no-go sebelum Mulai Penilaian -->
                    <div class="o_horizontal_separator mt-3 mb-2 text-uppercase fw-bolder small"
                         invisible="state != 'draft'">Kesiapan Periode</div>
                    <div class="vs-period__readiness d-flex flex-column gap-1 mb-2"
                         invisible="state != 'draft'">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-check-circle text-success" title="Terpenuhi" aria-hidden="true"
                               invisible="not date_from or not date_to"/>
                            <i class="fa fa-circle-o text-muted" title="Belum terpenuhi" aria-hidden="true"
                               invisible="date_from and date_to"/>
                            <span>Tanggal periode sudah terisi</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-check-circle text-success" title="Terpenuhi" aria-hidden="true"
                               invisible="not is_weight_valid"/>
                            <i class="fa fa-circle-o text-muted" title="Belum terpenuhi" aria-hidden="true"
                               invisible="is_weight_valid"/>
                            <span>Total bobot kriteria tepat 100%</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-check-circle text-success" title="Terpenuhi" aria-hidden="true"
                               invisible="partner_selected_count &lt; 2"/>
                            <i class="fa fa-circle-o text-muted" title="Belum terpenuhi" aria-hidden="true"
                               invisible="partner_selected_count &gt;= 2"/>
                            <span>Minimal 2 pemasok dipilih</span>
                        </div>
                    </div>

                    <!-- Kriteria Evaluasi (lebar penuh) -->
                    <div class="o_horizontal_separator mt-3 mb-2 d-flex align-items-center gap-2 text-uppercase fw-bolder small"
                         invisible="state != 'draft'">
                        <span>Kriteria Evaluasi</span>
                        <span class="badge text-bg-secondary rounded-pill"
                              invisible="not period_criterion_ids"><field name="criterion_count" class="d-inline"/></span>
                    </div>
                    <field name="period_criterion_ids" nolabel="1" readonly="state != 'draft'"
                           invisible="state != 'draft'">
                        <list string="Kriteria &amp; Bobot" editable="bottom">
                            <field name="criterion_id" options="{'no_create': True}"/>
                            <field name="criterion_type" readonly="1" force_save="1" widget="badge"
                                   decoration-success="criterion_type == 'benefit'"
                                   decoration-danger="criterion_type == 'cost'"/>
                            <field name="weight" widget="float" sum="Total Bobot" class="vs-num"/>
                        </list>
                    </field>
                    <div class="alert alert-light text-muted d-flex align-items-center gap-2 border"
                         role="status"
                         invisible="state != 'draft' or period_criterion_ids">
                        <i class="fa fa-lightbulb-o" title="Petunjuk" aria-hidden="true"/>
                        <span>Belum ada kriteria. Pilih <strong>Paket Kriteria</strong> di atas untuk mengisi otomatis,
                            atau klik <strong>Add a line</strong> untuk menambah manual.</span>
                    </div>

                    <!-- Pemasok yang Dievaluasi (lebar penuh) -->
                    <div class="o_horizontal_separator mt-4 mb-2 d-flex align-items-center gap-2 text-uppercase fw-bolder small"
                         invisible="state != 'draft'">
                        <span>Pemasok yang Dievaluasi</span>
                        <span class="badge text-bg-secondary rounded-pill"
                              invisible="not partner_ids"><field name="partner_selected_count" class="d-inline"/></span>
                    </div>
                    <field name="partner_ids" nolabel="1" invisible="state != 'draft'"
                           context="{'search_default_group_by_vendor_category': 1}">
                        <list string="Pemasok">
                            <field name="vendor_category" widget="badge" optional="show"/>
                            <field name="name"/>
                            <field name="city" optional="show"/>
                            <field name="phone" optional="hide"/>
                        </list>
                    </field>
                    <div class="alert alert-light text-muted d-flex align-items-center gap-2 border"
                         role="status"
                         invisible="state != 'draft' or partner_ids">
                        <i class="fa fa-lightbulb-o" title="Petunjuk" aria-hidden="true"/>
                        <span>Belum ada pemasok. Klik <strong>Add a line</strong> untuk memilih pemasok yang akan dievaluasi.</span>
                    </div>

                    <!-- Mode Active (Scoring/Calculated/Validated): Slim Header -->
                    <group invisible="state == 'draft'">
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="is_weight_valid" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="evaluator_id" widget="many2one_avatar_user" readonly="state == 'validated'"/>
                            <field name="validator_id" widget="many2one_avatar_user" readonly="1" invisible="state not in ('validated',)"/>
                            <field name="validation_date" readonly="1" invisible="state not in ('validated',)"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Matrix Scoring (OWL) - Fokus utama saat eksekusi -->
                        <page string="Matrix Penilaian" name="page_matrix"
                              autofocus="autofocus"
                              invisible="state != 'scoring'">
                            <widget name="scoring_matrix"/>
                        </page>

                        <!-- Tab 2: Hasil Ranking - Fokus utama setelah terhitung -->
                        <page string="Hasil Ranking" name="page_ranking"
                              autofocus="autofocus"
                              invisible="state not in ('calculated', 'validated')">
                            <field name="vendor_score_ids" nolabel="1" readonly="1">
                                <list string="Perangkingan Pemasok"
                                      decoration-success="rank == 1"
                                      decoration-warning="rank == 2"
                                      decoration-info="rank == 3"
                                      default_order="rank">
                                    <field name="rank" column_invisible="1"/>
                                    <field name="rank_display" string="Peringkat"
                                           decoration-bf="rank &lt;= 3"/>
                                    <field name="partner_id" decoration-bf="rank == 1"/>
                                    <field name="final_score" widget="float"
                                           class="vs-num"
                                           decoration-bf="rank == 1"/>
                                    <field name="is_recommended" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 3: Audit Skor Detail - Hanya jika perlu audit angka mentah -->
                        <page string="Audit Skor Detail" name="page_scores"
                              invisible="state not in ('calculated', 'validated')">
                            <field name="vendor_score_ids" nolabel="1"
                                   readonly="state in ('calculated', 'validated')">
                                <list string="Skor Pemasok"
                                      decoration-success="is_recommended">
                                    <field name="period_state" column_invisible="1"/>
                                    <field name="rank" readonly="1"
                                           optional="show"
                                           decoration-bf="rank == 1"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="score_line_ids" widget="many2many_tags"
                                           invisible="1"/>
                                    <field name="final_score" readonly="1"
                                           class="vs-num"
                                           decoration-bf="is_recommended"
                                           optional="show"/>
                                    <field name="is_recommended" readonly="1"
                                           widget="boolean_toggle"
                                           optional="show"/>
                                    <button name="action_open_score_detail"
                                            string="Rincian Kalkulasi"
                                            type="object"
                                            icon="fa-list-alt"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 4: Catatan - Selalu terlihat -->
                        <page string="Catatan" name="page_notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Catatan periode ini..."
                                   readonly="state == 'validated'"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter / Mail Thread -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Scoring Period: Search View -->
    <!-- ============================================================ -->
    <record id="view_scoring_period_search" model="ir.ui.view">
        <field name="name">scoring.period.search</field>
        <field name="model">scoring.period</field>
        <field name="arch" type="xml">
            <search string="Cari Periode Evaluasi">
                <field name="name"/>
                <field name="evaluator_id"/>
                <field name="validator_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Penilaian" name="filter_scoring"
                        domain="[('state', '=', 'scoring')]"/>
                <filter string="Terhitung" name="filter_calculated"
                        domain="[('state', '=', 'calculated')]"/>
                <filter string="Tervalidasi" name="filter_validated"
                        domain="[('state', '=', 'validated')]"/>
                <separator/>
                <filter string="Tahun Ini" name="filter_this_year"
                        domain="[('date_from', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%%Y-%%m-%%d')),
                                 ('date_from', '&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter string="Periode Aktif" name="filter_active_period"
                        domain="[('date_from', '&lt;=', context_today().strftime('%%Y-%%m-%%d')),
                                 ('date_to', '&gt;=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Bobot Tidak Valid" name="filter_invalid_weight"
                        domain="[('is_weight_valid', '=', False)]"/>
                <separator/>
                <filter string="Saya Evaluator" name="filter_my_evaluator"
                        domain="[('evaluator_id', '=', uid)]"/>
                <filter string="Saya Validator" name="filter_my_validator"
                        domain="[('validator_id', '=', uid)]"/>
                <group>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Evaluator" name="group_evaluator"
                            context="{'group_by': 'evaluator_id'}"/>
                    <filter string="Kuartal" name="group_quarter"
                            context="{'group_by': 'date_from:quarter'}"/>
                    <filter string="Tahun" name="group_year"
                            context="{'group_by': 'date_from:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Scoring Period: Action -->
    <!-- ============================================================ -->
    <record id="action_scoring_period" model="ir.actions.act_window">
        <field name="name">Periode Evaluasi</field>
        <field name="res_model">scoring.period</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="context">{'search_default_filter_draft': 1, 'search_default_filter_scoring': 1, 'search_default_filter_calculated': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat periode evaluasi baru!
            </p>
            <p>
                Mulai evaluasi pemasok dalam <b>3 langkah mudah</b>:
            </p>
            <ol>
                <li><b>Setup Kriteria</b> — Tentukan kriteria evaluasi (Kualitas, Harga, dll) di menu Konfigurasi → Kriteria Evaluasi</li>
                <li><b>Buat Periode</b> — Buat periode evaluasi baru, pilih kriteria dan pemasok yang akan dinilai</li>
                <li><b>Mulai Evaluasi</b> — Klik "Mulai Penilaian", input skor, lalu sistem menghitung ranking otomatis</li>
            </ol>
            <p>
                Sistem menggunakan metode <b>Simple Additive Weighting (SAW)</b> untuk menghitung peringkat pemasok secara objektif.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Vendor Score: Form View (popup detail) -->
    <!-- ============================================================ -->
    <record id="view_vendor_score_form" model="ir.ui.view">
        <field name="name">vendor.score.form</field>
        <field name="model">vendor.score</field>
        <field name="arch" type="xml">
            <form string="Detail Skor Pemasok">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_id" readonly="1"/>
                            <field name="rank" readonly="1"/>
                        </group>
                        <group>
                            <field name="final_score" readonly="1" class="vs-num"/>
                            <field name="is_recommended" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="score_line_ids" nolabel="1">
                        <list string="Detail Skor per Kriteria" editable="bottom">
                            <field name="criterion_id" readonly="1"/>
                            <field name="criterion_type" readonly="1" widget="badge"
                                   decoration-success="criterion_type == 'benefit'"
                                   decoration-danger="criterion_type == 'cost'"/>
                            <field name="criterion_weight" readonly="1" class="vs-num"/>
                            <field name="raw_score" class="vs-num"/>
                            <field name="normalized_score" readonly="1" class="vs-num"/>
                            <field name="weighted_score" readonly="1" class="vs-num"/>
                        </list>
                    </field>
                </sheet>
                <!-- Chatter / Mail Thread -->
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
