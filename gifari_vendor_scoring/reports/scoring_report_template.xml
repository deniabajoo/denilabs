<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- QWeb Report Template: Laporan Evaluasi Pemasok -->
    <!-- ============================================================ -->
    <template id="report_vendor_scoring">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="period">
                <t t-call="web.basic_layout">
                    <!-- Paksa font sistem: font tema Odoo (mis. Lato) tidak
                         tersedia/ gagal di-fetch oleh wkhtmltopdf di sebagian OS
                         (mis. macOS) sehingga teks tampil kosong walau border &
                         background tetap render. Stack sistem ini selalu ada. -->
                    <style>
                        .page, .page * {
                            font-family: Arial, Helvetica, "Liberation Sans", sans-serif !important;
                            color: #000;
                        }
                        .page table th { color: #fff !important; }
                    </style>
                    <div class="page position-relative">
                        <!-- Watermark -->
                        <div t-if="period.state == 'validated'" class="position-absolute" 
                             style="font-size: 6rem; font-weight: bold; top: 30%; left: 15%; transform: rotate(-30deg); z-index: -1; color: rgba(40, 167, 69, 0.15);">
                            TERVALIDASI
                        </div>
                        <div t-if="period.state in ['draft', 'scoring', 'calculated']" class="position-absolute" 
                             style="font-size: 6rem; font-weight: bold; top: 30%; left: 20%; transform: rotate(-30deg); z-index: -1; color: rgba(220, 53, 69, 0.15);">
                            DRAFT
                        </div>

                        <!-- Header Laporan -->
                        <div class="text-center mb-4">
                            <h2>
                                <strong>LAPORAN EVALUASI PEMASOK</strong>
                                <span t-if="period.state == 'validated'" style="background-color: #198754; color: white; padding: 2px 8px; border-radius: 12px; font-size: 14px; vertical-align: middle; margin-left: 10px;">✓ Tervalidasi</span>
                                <span t-if="period.state != 'validated'" style="background-color: #6c757d; color: white; padding: 2px 8px; border-radius: 12px; font-size: 14px; vertical-align: middle; margin-left: 10px;">Draft</span>
                            </h2>
                            <h4>Metode Simple Additive Weighting (SAW)</h4>
                        </div>

                        <!-- Informasi Periode -->
                        <table class="table table-sm table-bordered mb-4" style="width: 50%;">
                            <tr>
                                <td style="width: 40%;"><strong>Periode</strong></td>
                                <td><t t-out="period.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Tanggal</strong></td>
                                <td>
                                    <t t-out="period.date_from" t-options='{"widget": "date"}'/> s/d
                                    <t t-out="period.date_to" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Evaluator</strong></td>
                                <td><t t-out="period.evaluator_id.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>Validator</strong></td>
                                <td><t t-out="period.validator_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <td><strong>Status</strong></td>
                                <td><t t-out="dict(period.fields_get(allfields=['state'])['state']['selection'])[period.state]"/></td>
                            </tr>
                        </table>

                        <!-- ============================================ -->
                        <!-- Bagian 1: Kriteria Evaluasi -->
                        <!-- ============================================ -->
                        <h5 class="mt-4 mb-2"><strong>1. Kriteria Evaluasi &amp; Bobot</strong></h5>
                        <table class="table table-sm table-bordered table-striped" style="vertical-align: middle;">
                            <thead>
                                <tr style="background-color: #343a40;">
                                    <th style="width: 10%; text-align: center; color: white;">Kode</th>
                                    <th style="width: 40%; color: white;">Nama Kriteria</th>
                                    <th style="width: 20%; text-align: center; color: white;">Tipe</th>
                                    <th style="width: 15%; text-align: center; color: white;">Bobot (%)</th>
                                    <th style="width: 15%; text-align: center; color: white;">Bobot (Desimal)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="period.period_criterion_ids.sorted(key=lambda c: c.sequence)" t-as="criterion">
                                    <tr>
                                        <td style="text-align: center;"><strong><t t-out="criterion.criterion_id.code"/></strong></td>
                                        <td><t t-out="criterion.criterion_id.name"/></td>
                                        <td style="text-align: center;">
                                            <span t-if="criterion.criterion_type == 'benefit'"
                                                  style="background-color: #198754; color: white; padding: 3px 8px; border-radius: 4px; font-size: 12px;">Benefit</span>
                                            <span t-else=""
                                                  style="background-color: #dc3545; color: white; padding: 3px 8px; border-radius: 4px; font-size: 12px;">Cost</span>
                                        </td>
                                        <td style="text-align: center;">
                                            <t t-out="'%.1f' % criterion.weight"/>%
                                        </td>
                                        <td style="text-align: center;">
                                            <t t-out="'%.4f' % criterion.weight_decimal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #e9ecef;">
                                    <td colspan="3"><strong>Total Bobot</strong></td>
                                    <td style="text-align: right;">
                                        <strong><t t-out="'%.1f' % period.total_weight"/>%</strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <strong><t t-out="'%.4f' % (period.total_weight / 100.0)"/></strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ============================================ -->
                        <!-- Bagian 2: Matriks Keputusan (Skor Mentah) -->
                        <!-- ============================================ -->
                        <h5 class="mt-4 mb-2"><strong>2. Matriks Keputusan (Skor Mentah)</strong></h5>
                        <table class="table table-sm table-bordered table-striped" style="vertical-align: middle;">
                            <thead>
                                <tr style="background-color: #343a40;">
                                    <th style="color: white;">Pemasok</th>
                                    <t t-foreach="period.period_criterion_ids.sorted(key=lambda c: c.sequence)" t-as="criterion">
                                        <th style="text-align: center; color: white;">
                                            <t t-out="criterion.criterion_id.code"/><br/>
                                            <span style="font-size: 10px; font-weight: normal; color: white;">(<t t-out="criterion.criterion_type.title()"/>)</span>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="period.vendor_score_ids.sorted(key=lambda vs: vs.rank)" t-as="vendor_score">
                                    <tr>
                                        <td><t t-out="vendor_score.partner_id.name"/></td>
                                        <t t-foreach="period.period_criterion_ids.sorted(key=lambda c: c.sequence)" t-as="criterion">
                                            <t t-set="score_line" t-value="vendor_score.score_line_ids.filtered(lambda sl: sl.criterion_id.id == criterion.criterion_id.id)"/>
                                            <td style="text-align: center;">
                                                <t t-out="'%.2f' % score_line.raw_score if score_line else '-'"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ============================================ -->
                        <!-- Bagian 3: Matriks Normalisasi -->
                        <!-- ============================================ -->
                        <h5 class="mt-4 mb-2"><strong>3. Matriks Normalisasi (rᵢⱼ)</strong></h5>
                        <p style="font-size: 12px; color: #6c757d; margin-bottom: 8px;">
                            <strong>ℹ</strong> 
                            Benefit: rᵢⱼ = xᵢⱼ / max(xⱼ) &amp;nbsp;|&amp;nbsp; Cost: rᵢⱼ = min(xⱼ) / xᵢⱼ
                        </p>
                        <table class="table table-sm table-bordered table-striped" style="vertical-align: middle;">
                            <thead>
                                <tr style="background-color: #343a40;">
                                    <th style="color: white;">Pemasok</th>
                                    <t t-foreach="period.period_criterion_ids.sorted(key=lambda c: c.sequence)" t-as="criterion">
                                        <th style="text-align: center; color: white;">
                                            <t t-out="criterion.criterion_id.code"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="period.vendor_score_ids.sorted(key=lambda vs: vs.rank)" t-as="vendor_score">
                                    <tr>
                                        <td><t t-out="vendor_score.partner_id.name"/></td>
                                        <t t-foreach="period.period_criterion_ids.sorted(key=lambda c: c.sequence)" t-as="criterion">
                                            <t t-set="score_line" t-value="vendor_score.score_line_ids.filtered(lambda sl: sl.criterion_id.id == criterion.criterion_id.id)"/>
                                            <td style="text-align: center;">
                                                <t t-out="'%.4f' % score_line.normalized_score if score_line else '-'"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ============================================ -->
                        <!-- Bagian 4: Hasil Perangkingan -->
                        <!-- ============================================ -->
                        <h5 class="mt-4 mb-2"><strong>4. Hasil Perangkingan</strong></h5>
                        <p style="font-size: 12px; color: #6c757d; margin-bottom: 8px;">
                            <strong>∑</strong> Vᵢ = Σ(wⱼ × rᵢⱼ) — Semakin besar nilai Vᵢ, semakin tinggi peringkat.
                        </p>
                        <table class="table table-sm table-bordered" style="vertical-align: middle;">
                            <thead>
                                <tr style="background-color: #343a40;">
                                    <th style="width: 10%; text-align: center; color: white;">Rank</th>
                                    <th style="width: 50%; color: white;">Pemasok</th>
                                    <th style="width: 20%; text-align: center; color: white;">Skor Akhir (Vᵢ)</th>
                                    <th style="width: 20%; text-align: center; color: white;">Rekomendasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="period.vendor_score_ids.sorted(key=lambda vs: vs.rank)" t-as="vendor_score">
                                    <tr t-att-style="'background-color: #d1e7dd; font-weight: bold;' if vendor_score.is_recommended else ''">
                                        <td style="text-align: center;">
                                            <t t-out="vendor_score.rank"/>
                                        </td>
                                        <td>
                                            <t t-out="vendor_score.partner_id.name"/>
                                        </td>
                                        <td style="text-align: center;">
                                            <strong><t t-out="'%.4f' % vendor_score.final_score"/></strong>
                                        </td>
                                        <td style="text-align: center;">
                                            <span t-if="vendor_score.is_recommended"
                                                  style="background-color: #198754; color: white; padding: 4px 10px; border-radius: 12px; font-size: 12px;">★ Terbaik</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ============================================ -->
                        <!-- Bagian 5: Kesimpulan -->
                        <!-- ============================================ -->
                        <t t-set="best_vendor" t-value="period.vendor_score_ids.filtered(lambda vs: vs.is_recommended)"/>
                        <div class="mt-4 p-3" t-if="best_vendor" style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px;">
                            <h5 style="margin-top: 0;"><strong>Kesimpulan</strong></h5>
                            <p style="margin-bottom: 0;">
                                Berdasarkan hasil perhitungan metode Simple Additive Weighting (SAW),
                                pemasok dengan nilai preferensi tertinggi adalah
                                <strong><t t-out="best_vendor[0].partner_id.name"/></strong>
                                dengan skor akhir
                                <strong><t t-out="'%.4f' % best_vendor[0].final_score"/></strong>.
                                Pemasok ini direkomendasikan sebagai pilihan utama untuk periode evaluasi
                                <t t-out="period.name"/>.
                            </p>
                        </div>

                        <!-- ============================================ -->
                        <!-- Tanda Tangan -->
                        <!-- ============================================ -->
                        <div class="row mt-5 pt-3">
                            <div class="col-6 text-center">
                                <p style="margin-bottom: 70px;">Evaluator,</p>
                                <p class="mb-0"><strong><t t-out="period.evaluator_id.name"/></strong></p>
                                <span style="font-size: 12px; color: #6c757d;"><t t-out="period.create_date" t-options='{"widget": "date"}'/></span>
                            </div>
                            <div class="col-6 text-center">
                                <p style="margin-bottom: 70px;">Validator,</p>
                                <p class="mb-0"><strong><t t-out="period.validator_id.name or '________________'"/></strong></p>
                                <span style="font-size: 12px; color: #6c757d;">
                                    <t t-if="period.validation_date" t-out="period.validation_date" t-options='{"widget": "date"}'/>
                                    <t t-else="">Tanggal: ___/___/20__</t>
                                </span>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
