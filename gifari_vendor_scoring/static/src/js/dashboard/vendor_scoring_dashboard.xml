<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gifari_vendor_scoring.Dashboard" owl="1">
        <div class="vs-dashboard o_action">
            <!-- Loading -->
            <div t-if="state.loading" class="vs-dashboard__loading text-center p-5" role="status" aria-live="polite">
                <i class="fa fa-spinner fa-spin fa-3x text-primary" aria-hidden="true"/>
                <p class="mt-3 text-muted fs-5">Memuat dashboard...</p>
            </div>

            <div t-if="!state.loading" class="vs-dashboard__content p-3">
                <!-- Header -->
                <div class="vs-dashboard__header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <div>
                        <h2 class="mb-0">
                            <i class="fa fa-bar-chart me-2" aria-hidden="true"/> Vendor Scoring Dashboard
                        </h2>
                        <small class="text-muted" t-if="state.latest_period">
                            Periode fokus: <strong t-out="state.latest_period.name"/>
                        </small>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div t-if="state.available_periods.length" class="vs-dashboard__period-filter">
                            <label for="vs_focus_period" class="form-label visually-hidden">Pilih periode</label>
                            <select id="vs_focus_period" class="form-select form-select-sm"
                                    t-on-change="onFocusPeriodChange">
                                <t t-foreach="state.available_periods" t-as="period" t-key="period.id">
                                    <option t-att-value="period.id"
                                            t-att-selected="period.id === state.focus_period_id"
                                            t-out="period.name"/>
                                </t>
                            </select>
                        </div>
                        <button class="btn btn-primary btn-sm" t-on-click="openPeriodList">
                            <i class="fa fa-list me-1" aria-hidden="true"/> Semua Periode
                        </button>
                    </div>
                </div>

                <!-- Guided empty state: belum ada periode tervalidasi -->
                <div t-if="!state.latest_period" class="vs-dashboard__empty text-center p-5 mb-4">
                    <i class="fa fa-trophy fa-3x text-warning mb-3" aria-hidden="true"/>
                    <h4 class="mb-1">Belum ada periode tervalidasi</h4>
                    <p class="text-muted mb-3">
                        Hasil perangkingan akan muncul di sini setelah sebuah periode evaluasi
                        dihitung dan divalidasi.
                    </p>
                    <button class="btn btn-primary" t-on-click="openPeriodList">
                        <i class="fa fa-plus me-1" aria-hidden="true"/> Buka Periode Evaluasi
                    </button>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- Active Period -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100"
                             t-att-class="state.active_period ? 'border-primary' : ''">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-clock-o fa-2x"
                                       aria-hidden="true"
                                       t-att-class="state.active_period ? 'text-primary' : 'text-muted'"/>
                                </div>
                                <div t-if="state.active_period">
                                    <h5 class="card-title mb-1" t-out="state.active_period.name"/>
                                    <div class="progress mb-1" style="height: 6px;"
                                         role="progressbar"
                                         t-att-aria-valuenow="Math.round(state.active_period.progress_percent)"
                                         aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-primary"
                                             t-attf-style="width: #{state.active_period.progress_percent}%;"/>
                                    </div>
                                    <small class="text-muted">
                                        <t t-out="state.active_period.vendor_count"/> vendor ·
                                        <t t-out="Math.round(state.active_period.progress_percent)"/>%
                                    </small>
                                </div>
                                <div t-else="">
                                    <p class="text-muted mb-0">Tidak ada periode aktif</p>
                                </div>
                                <div class="vs-dashboard__kpi-label mt-1">Periode Aktif</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Vendor -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100 border-warning">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-trophy fa-2x text-warning" aria-hidden="true"/>
                                </div>
                                <h5 class="mb-0" t-out="state.kpis.top_vendor_name"/>
                                <span t-if="state.kpis.top_vendor_band" class="badge rounded-pill mt-1"
                                      t-attf-class="text-bg-#{state.kpis.top_vendor_band.tone}"
                                      t-out="state.kpis.top_vendor_band.label"/>
                                <div class="vs-dashboard__kpi-label">Vendor Terbaik</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Score (skor + persen + band) -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-star fa-2x text-warning" aria-hidden="true"/>
                                </div>
                                <h3 class="mb-0 vs-dashboard__metric">
                                    <t t-out="state.kpis.top_vendor_score ? state.kpis.top_vendor_score.toFixed(4) : '—'"/>
                                </h3>
                                <small class="text-muted" t-if="state.kpis.top_vendor_score">
                                    setara <t t-out="Math.round(state.kpis.top_vendor_score * 100)"/>%
                                </small>
                                <div class="vs-dashboard__kpi-label">Skor Tertinggi</div>
                            </div>
                        </div>
                    </div>

                    <!-- Margin of Victory: keunggulan #1 vs runner-up -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-line-chart fa-2x text-primary" aria-hidden="true"/>
                                </div>
                                <div t-if="state.kpis.winner_margin">
                                    <h3 class="mb-0 vs-dashboard__metric">+<t t-out="state.kpis.winner_margin.toFixed(4)"/></h3>
                                    <small class="text-muted">
                                        <t t-out="state.kpis.winner_margin_percent"/>% di atas
                                        <t t-out="state.kpis.runner_up_name"/>
                                    </small>
                                </div>
                                <h3 t-else="" class="mb-0 vs-dashboard__metric">—</h3>
                                <div class="vs-dashboard__kpi-label">Keunggulan #1</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recommendation strip: keputusan + alasan + drill-down -->
                <div t-if="state.kpis.recommendation_reason and state.latest_period"
                     class="vs-dashboard__reco card mb-4">
                    <div class="card-body d-flex flex-wrap align-items-center gap-3">
                        <div class="vs-dashboard__reco-icon">
                            <i class="fa fa-trophy fa-2x" aria-hidden="true"/>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-uppercase small fw-bold text-muted">Rekomendasi Periode</div>
                            <div class="fs-5 fw-bold">
                                <t t-out="state.kpis.top_vendor_name"/>
                                <span t-if="state.kpis.top_vendor_band" class="badge rounded-pill ms-2"
                                      t-attf-class="text-bg-#{state.kpis.top_vendor_band.tone}"
                                      t-out="state.kpis.top_vendor_band.label"/>
                            </div>
                            <div class="text-muted" t-out="state.kpis.recommendation_reason"/>
                        </div>
                        <button class="btn btn-primary" t-if="state.top_vendors.length"
                                t-on-click="() => this.openVendorScore(state.top_vendors[0].vendor_score_id)">
                            <i class="fa fa-search me-1" aria-hidden="true"/> Lihat Rincian
                        </button>
                    </div>
                </div>

                <!-- Main Content Row -->
                <div class="row g-3 mb-4">
                    <!-- Top 5 Leaderboard -->
                    <div class="col-lg-4">
                        <div class="card h-100">
                            <div class="card-header fw-bold">
                                <i class="fa fa-list-ol me-1" aria-hidden="true"/> Top 5 Vendor
                                <small class="text-muted float-end" t-if="state.latest_period"
                                       t-out="state.latest_period.name"/>
                            </div>
                            <div class="card-body p-0">
                                <div t-if="!state.top_vendors.length" class="p-3 text-muted text-center">
                                    Belum ada data ranking.
                                </div>
                                <ul class="list-group list-group-flush" t-if="state.top_vendors.length">
                                    <t t-foreach="state.top_vendors" t-as="vendor" t-key="vendor.rank">
                                        <li class="list-group-item vs-leaderboard__item d-flex justify-content-between align-items-center"
                                            role="button" tabindex="0"
                                            t-att-title="'Lihat rincian skor ' + vendor.partner_name"
                                            t-on-click="() => this.openVendorScore(vendor.vendor_score_id)">
                                            <div>
                                                <div>
                                                    <span class="me-2 fw-bold" t-out="vendor.rank_display"/>
                                                    <span t-out="vendor.partner_name"/>
                                                </div>
                                                <small t-if="vendor.rank > 1" class="text-muted">
                                                    Δ <t t-out="vendor.delta_to_top.toFixed(4)"/> dari #1
                                                </small>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <t t-set="move" t-value="rankMovementInfo(vendor)"/>
                                                <span class="vs-leaderboard__move small" t-att-class="move.cls"
                                                      t-att-title="'Pergerakan peringkat vs periode sebelumnya'">
                                                    <i class="fa" t-attf-class="fa #{move.icon}" aria-hidden="true"/>
                                                    <t t-out="move.text"/>
                                                </span>
                                                <span class="badge rounded-pill"
                                                      t-attf-class="text-bg-#{vendor.score_band.tone}"
                                                      t-out="vendor.score_band.label"/>
                                                <span class="badge text-bg-primary rounded-pill vs-leaderboard__score">
                                                    <t t-out="vendor.final_score.toFixed(4)"/>
                                                </span>
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Comparison Chart -->
                    <div class="col-lg-8">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="vs-dashboard__chart-container">
                                    <canvas t-ref="comparisonCanvas"
                                            role="img"
                                            aria-label="Perbandingan skor terbobot per vendor"/>
                                </div>
                                <div t-if="!state.comparison_data.length" class="text-center text-muted py-4">
                                    Belum ada data perbandingan.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
