<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gifari_vendor_scoring.Dashboard" owl="1">
        <div class="vs-dashboard o_action">
            <!-- Loading -->
            <div t-if="state.loading" class="vs-dashboard__loading text-center p-5" role="status" aria-live="polite">
                <i class="fa fa-spinner fa-spin fa-3x text-primary" aria-hidden="true"/>
                <p class="mt-3 text-muted fs-5">Memuat dashboard...</p>
            </div>

            <div t-if="!state.loading" class="vs-dashboard__content p-3">
                <!-- Header -->
                <div class="vs-dashboard__header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <div>
                        <h2 class="mb-0">
                            <i class="fa fa-bar-chart me-2" aria-hidden="true"/> Vendor Scoring Dashboard
                        </h2>
                        <small class="text-muted" t-if="state.latest_period">
                            Periode fokus: <strong t-out="state.latest_period.name"/>
                        </small>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div t-if="state.available_periods.length" class="vs-dashboard__period-filter">
                            <label for="vs_focus_period" class="form-label visually-hidden">Pilih periode</label>
                            <select id="vs_focus_period" class="form-select form-select-sm"
                                    t-on-change="onFocusPeriodChange">
                                <t t-foreach="state.available_periods" t-as="period" t-key="period.id">
                                    <option t-att-value="period.id"
                                            t-att-selected="period.id === state.focus_period_id"
                                            t-out="period.name"/>
                                </t>
                            </select>
                        </div>
                        <button class="btn btn-primary btn-sm" t-on-click="openPeriodList">
                            <i class="fa fa-list me-1" aria-hidden="true"/> Semua Periode
                        </button>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- Active Period -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100"
                             t-att-class="state.active_period ? 'border-primary' : ''">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-clock-o fa-2x"
                                       aria-hidden="true"
                                       t-att-class="state.active_period ? 'text-primary' : 'text-muted'"/>
                                </div>
                                <div t-if="state.active_period">
                                    <h5 class="card-title mb-1" t-out="state.active_period.name"/>
                                    <div class="progress mb-1" style="height: 6px;"
                                         role="progressbar"
                                         t-att-aria-valuenow="Math.round(state.active_period.progress_percent)"
                                         aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-primary"
                                             t-attf-style="width: #{state.active_period.progress_percent}%;"/>
                                    </div>
                                    <small class="text-muted">
                                        <t t-out="state.active_period.vendor_count"/> vendor ·
                                        <t t-out="Math.round(state.active_period.progress_percent)"/>%
                                    </small>
                                </div>
                                <div t-else="">
                                    <p class="text-muted mb-0">Tidak ada periode aktif</p>
                                </div>
                                <div class="vs-dashboard__kpi-label mt-1">Periode Aktif</div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Periods -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-calendar-check-o fa-2x text-success" aria-hidden="true"/>
                                </div>
                                <h3 class="mb-0 vs-dashboard__metric" t-out="state.kpis.total_periods"/>
                                <div class="vs-dashboard__kpi-label">Periode Tervalidasi</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Vendor -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100 border-warning">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-trophy fa-2x text-warning" aria-hidden="true"/>
                                </div>
                                <h5 class="mb-0" t-out="state.kpis.top_vendor_name"/>
                                <div class="vs-dashboard__kpi-label">Vendor Terbaik</div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Score -->
                    <div class="col-lg-3 col-md-6">
                        <div class="vs-dashboard__kpi-card card h-100">
                            <div class="card-body text-center">
                                <div class="vs-dashboard__kpi-icon mb-2">
                                    <i class="fa fa-star fa-2x text-warning" aria-hidden="true"/>
                                </div>
                                <h3 class="mb-0 vs-dashboard__metric">
                                    <t t-out="state.kpis.top_vendor_score ? state.kpis.top_vendor_score.toFixed(4) : '—'"/>
                                </h3>
                                <div class="vs-dashboard__kpi-label">Skor Tertinggi</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Row -->
                <div class="row g-3 mb-4">
                    <!-- Top 5 Leaderboard -->
                    <div class="col-lg-4">
                        <div class="card h-100">
                            <div class="card-header fw-bold">
                                <i class="fa fa-list-ol me-1" aria-hidden="true"/> Top 5 Vendor
                                <small class="text-muted float-end" t-if="state.latest_period"
                                       t-out="state.latest_period.name"/>
                            </div>
                            <div class="card-body p-0">
                                <div t-if="!state.top_vendors.length" class="p-3 text-muted text-center">
                                    Belum ada data ranking.
                                </div>
                                <ul class="list-group list-group-flush" t-if="state.top_vendors.length">
                                    <t t-foreach="state.top_vendors" t-as="vendor" t-key="vendor.rank">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="me-2 fw-bold" t-out="vendor.rank_display"/>
                                                <span t-out="vendor.partner_name"/>
                                            </div>
                                            <span class="badge text-bg-primary rounded-pill vs-leaderboard__score">
                                                <t t-out="vendor.final_score.toFixed(4)"/>
                                            </span>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Comparison Chart -->
                    <div class="col-lg-8">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="vs-dashboard__chart-container">
                                    <canvas t-ref="comparisonCanvas"
                                            role="img"
                                            aria-label="Perbandingan skor terbobot per vendor"/>
                                </div>
                                <div t-if="!state.comparison_data.length" class="text-center text-muted py-4">
                                    Belum ada data perbandingan.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Radar + Trend Row -->
                <div class="row g-3">
                    <!-- Radar: criteria profile -->
                    <div class="col-lg-5">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="vs-dashboard__chart-container">
                                    <canvas t-ref="radarCanvas"
                                            role="img"
                                            aria-label="Profil kriteria tiga vendor teratas"/>
                                </div>
                                <div t-if="!state.comparison_data.length" class="text-center text-muted py-4">
                                    Belum ada data profil kriteria.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Trend Chart -->
                    <div class="col-lg-7">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="vs-dashboard__chart-container">
                                    <canvas t-ref="trendCanvas"
                                            role="img"
                                            aria-label="Trend skor antar periode"/>
                                </div>
                                <div t-if="!state.period_trend.length" class="text-center text-muted py-4">
                                    Belum ada data trend. Validasi minimal 2 periode untuk melihat trend.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
