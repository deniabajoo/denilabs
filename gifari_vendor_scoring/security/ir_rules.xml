<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Multi-Company Record Rules -->
        <!-- ============================================================ -->

        <record id="scoring_criterion_company_rule" model="ir.rule">
            <field name="name">Scoring Criterion: multi-company</field>
            <field name="model_id" ref="model_scoring_criterion"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="scoring_period_company_rule" model="ir.rule">
            <field name="name">Scoring Period: multi-company</field>
            <field name="model_id" ref="model_scoring_period"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="vendor_score_company_rule" model="ir.rule">
            <field name="name">Vendor Score: multi-company</field>
            <field name="model_id" ref="model_vendor_score"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ============================================================ -->
        <!-- Validated Period Protection -->
        <!-- Evaluator tidak bisa edit periode yang sudah tervalidasi -->
        <!-- ============================================================ -->

        <record id="scoring_period_validated_rule" model="ir.rule">
            <field name="name">Scoring Period: evaluator cannot edit validated</field>
            <field name="model_id" ref="model_scoring_period"/>
            <field name="domain_force">[('state', '!=', 'validated')]</field>
            <field name="groups" eval="[(4, ref('group_vendor_scoring_evaluator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Validator dan Configurator bisa melihat semua -->
        <record id="scoring_period_validator_rule" model="ir.rule">
            <field name="name">Scoring Period: validator sees all</field>
            <field name="model_id" ref="model_scoring_period"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_vendor_scoring_validator'))]"/>
        </record>

    </data>
</odoo>
