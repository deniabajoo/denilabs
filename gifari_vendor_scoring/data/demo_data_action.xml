<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Server Action: Generate Demo Data -->
    <record id="action_generate_demo_data" model="ir.actions.server">
        <field name="name">Load Demo Data Vendor Scoring</field>
        <field name="model_id" ref="model_scoring_period"/>
        <field name="state">code</field>
        <field name="code">action = model.generate_demo_data()</field>
    </record>

    <!-- Menu: Purchase > Configuration > Load Demo Data Vendor Scoring -->
    <menuitem id="menu_load_demo_data"
              name="Load Demo Data Vendor Scoring"
              parent="purchase.menu_purchase_config"
              action="action_generate_demo_data"
              sequence="99"/>

</odoo>
