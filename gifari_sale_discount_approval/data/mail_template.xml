<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Email: Approval Request -->
    <record id="email_template_discount_approval_request" model="mail.template">
        <field name="name">Sale Discount: Approval Request</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">
            [Approval Required] Discount {{ round(object.effective_max_discount, 2) }}%
            pada {{ object.name }}
        </field>
        <field name="email_from">{{ (object.company_id.email or '') }}</field>
        <field name="partner_to"/>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <h2 style="color: #875A7B;">🔔 Discount Approval Diperlukan</h2>
    <p>Yth. <strong>{{ ctx.get('approver_name', 'Approver') }}</strong>,</p>
    <p>Sales Order berikut memerlukan persetujuan diskon Anda:</p>
    <table style="border-collapse: collapse; width: 100%;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; width: 200px;"><strong>Nomor SO</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Customer</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.partner_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Max Discount</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd; color: #d9534f;">
                <strong>{{ round(object.effective_max_discount, 2) }}%</strong>
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Total Amount</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                {{ object.currency_id.symbol }} {{ round(object.amount_total, 2) }}
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Level Approval</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                {{ ctx.get('level_name', object.current_approval_level_id.name) }}
            </td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Deadline</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd; color: #d9534f;">
                {% if object.approval_deadline %}
                    {{ object.approval_deadline.strftime('%d/%m/%Y %H:%M') }}
                {% else %}
                    -
                {% endif %}
            </td>
        </tr>
    </table>
    <br/>
    <p>
        Silakan login ke sistem Odoo Anti Gravity untuk melakukan approve/reject.
    </p>
    <p style="margin-top: 20px; font-size: 12px; color: #888;">
        Email ini dikirim otomatis oleh sistem. Harap tidak membalas email ini.
    </p>
</div>
        ]]></field>
    </record>

    <!-- Email: Approval Rejected -->
    <record id="email_template_discount_approval_rejected" model="mail.template">
        <field name="name">Sale Discount: Approval Rejected</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">
            [DITOLAK] Discount pada {{ object.name }} tidak disetujui
        </field>
        <field name="email_from">{{ (object.company_id.email or '') }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
    <h2 style="color: #d9534f;">❌ Permohonan Diskon Ditolak</h2>
    <p>Yth. <strong>{{ object.submitted_by.name }}</strong>,</p>
    <p>Permohonan diskon untuk Sales Order berikut <strong>DITOLAK</strong>:</p>
    <table style="border-collapse: collapse; width: 100%;">
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd; width: 200px;"><strong>Nomor SO</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Customer</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ object.partner_id.name }}</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Diskon Diajukan</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd;">{{ round(object.effective_max_discount, 2) }}%</td>
        </tr>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;"><strong>Alasan Penolakan</strong></td>
            <td style="padding: 8px; border: 1px solid #ddd; color: #d9534f;">
                <strong>{{ ctx.get('rejection_reason', '-') }}</strong>
            </td>
        </tr>
    </table>
    <br/>
    <p>
        Silakan sesuaikan diskon pada Sales Order dan submit ulang permohonan approval.
    </p>
</div>
        ]]></field>
    </record>

</data>
</odoo>
