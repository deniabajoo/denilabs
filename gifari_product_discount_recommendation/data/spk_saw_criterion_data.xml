<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <record id="criterion_stock_age" model="spk.saw.criterion">
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">10</field>
        <field name="name">Stock Age (Umur Stok)</field>
        <field name="code">stock_age</field>
        <field name="criterion_type">cost</field>
        <field name="weight">30.0</field>
        <field name="score_threshold_recommend">0.6</field>
        <field name="score_threshold_high">0.8</field>
        <field name="description">Mengukur seberapa lama produk berada di gudang. Dihitung sebagai: on_hand_qty / daily_demand (hari).</field>
    </record>

    <record id="criterion_overstocking_ratio" model="spk.saw.criterion">
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">20</field>
        <field name="name">Overstocking Ratio</field>
        <field name="code">overstocking_ratio</field>
        <field name="criterion_type">cost</field>
        <field name="weight">25.0</field>
        <field name="score_threshold_recommend">0.6</field>
        <field name="score_threshold_high">0.8</field>
        <field name="description">Perbandingan stok tersedia vs kebutuhan 30 hari. Nilai > 1.0 = overstock.</field>
    </record>

    <record id="criterion_margin_safety" model="spk.saw.criterion">
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">30</field>
        <field name="name">Margin Safety (Keamanan Margin)</field>
        <field name="code">margin_safety</field>
        <field name="criterion_type">benefit</field>
        <field name="weight">25.0</field>
        <field name="score_threshold_recommend">0.6</field>
        <field name="score_threshold_high">0.8</field>
        <field name="description">Persentase keuntungan bersih. Margin tinggi = aman diberi diskon.</field>
    </record>

    <record id="criterion_demand_trend" model="spk.saw.criterion">
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">40</field>
        <field name="name">Demand Trend (Tren Permintaan)</field>
        <field name="code">demand_trend</field>
        <field name="criterion_type">benefit</field>
        <field name="weight">20.0</field>
        <field name="score_threshold_recommend">0.6</field>
        <field name="score_threshold_high">0.8</field>
        <field name="description">Rata-rata penjualan harian 90 hari terakhir (units/day).</field>
    </record>

</data>
</odoo>
