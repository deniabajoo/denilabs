<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <record id="privilege_spk_discount_recommendation" model="res.groups.privilege">
        <field name="name">SPK Discount Recommendation</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_spk_manager" model="res.groups">
        <field name="name">SPK Discount Manager</field>
        <field name="privilege_id" ref="privilege_spk_discount_recommendation"/>
        <field name="implied_ids" eval="[
            (4, ref('gifari_sale_discount_approval.group_sale_approval_manager'))
        ]"/>
        <field name="user_ids" eval="[
            (4, ref('base.user_root')),
            (4, ref('base.user_admin'))
        ]"/>
    </record>

    <record id="group_spk_user" model="res.groups">
        <field name="name">SPK Discount User</field>
        <field name="privilege_id" ref="privilege_spk_discount_recommendation"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

</data>
</odoo>
