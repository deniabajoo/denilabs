<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_spk_saw_product_score_tree" model="ir.ui.view">
        <field name="name">spk.saw.product.score.tree</field>
        <field name="model">spk.saw.product.score</field>
        <field name="arch" type="xml">
            <list string="SPK Product Recommendations" default_order="saw_score desc"
                  decoration-danger="recommendation_level == 'high'"
                  decoration-warning="recommendation_level == 'medium'"
                  decoration-info="recommendation_level == 'low'"
                  decoration-muted="recommendation_level == 'none'">
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="saw_score" widget="progressbar" options="{'max_value': 1, 'title': 'SAW Score'}"/>
                <field name="recommendation_level"/>
                <field name="recommended_discount_percent" string="Rec. Discount (%)"/>
                <field name="raw_stock_age" string="Stock Age (days)" optional="show"/>
                <field name="raw_overstocking_ratio" string="Overstock Ratio" optional="show"/>
                <field name="raw_margin_safety" string="Margin (%)" optional="show"/>
                <field name="raw_demand_trend" string="Demand/day" optional="show"/>
                <field name="last_computed" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_spk_saw_product_score_form" model="ir.ui.view">
        <field name="name">spk.saw.product.score.form</field>
        <field name="model">spk.saw.product.score</field>
        <field name="arch" type="xml">
            <form string="SPK Product Score" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="recommendation_level not in ('high', 'medium')">
                        <field name="recommendation_rationale" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group string="Hasil SAW">
                            <field name="saw_score"/>
                            <field name="recommendation_level"/>
                            <field name="recommended_discount_percent"/>
                            <field name="last_computed"/>
                        </group>
                        <group string="Raw Values (Input)">
                            <field name="raw_stock_age"/>
                            <field name="raw_overstocking_ratio"/>
                            <field name="raw_margin_safety"/>
                            <field name="raw_demand_trend"/>
                        </group>
                    </group>
                    <group string="Normalized Values (0-1)">
                        <group>
                            <field name="norm_stock_age"/>
                            <field name="norm_overstocking_ratio"/>
                        </group>
                        <group>
                            <field name="norm_margin_safety"/>
                            <field name="norm_demand_trend"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_spk_saw_product_score_kanban" model="ir.ui.view">
        <field name="name">spk.saw.product.score.kanban</field>
        <field name="model">spk.saw.product.score</field>
        <field name="arch" type="xml">
            <kanban default_group_by="recommendation_level" class="o_kanban_small_column" records_draggable="false">
                <field name="product_id"/>
                <field name="saw_score"/>
                <field name="recommended_discount_percent"/>
                <field name="recommendation_level"/>
                <field name="recommendation_rationale"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong><field name="product_id"/></strong>
                            <div>SAW Score: <b><field name="saw_score"/></b></div>
                            <div>Rec. Discount: <b><field name="recommended_discount_percent"/>%</b></div>
                            <div class="text-muted small">
                                <field name="recommendation_rationale"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_spk_saw_product_score" model="ir.actions.act_window">
        <field name="name">Rekomendasi Diskon (SPK)</field>
        <field name="res_model">spk.saw.product.score</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_spk_run_scoring_wizard" model="ir.actions.act_window">
        <field name="name">Hitung Ulang Scoring SAW</field>
        <field name="res_model">spk.run.scoring.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
