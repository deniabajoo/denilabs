<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_spk_integration" model="ir.ui.view">
        <field name="name">sale.order.spk.integration</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="spk_recommended_discount" optional="show" string="SPK Rec. Disc. (%)"/>
                <field name="spk_recommendation_level" optional="show" string="SPK Level"
                       decoration-danger="spk_recommendation_level == 'high'"
                       decoration-warning="spk_recommendation_level == 'medium'"
                       decoration-info="spk_recommendation_level == 'low'"/>
                <field name="discount_variance_state" optional="hide"
                       decoration-danger="discount_variance_state == 'over'"
                       decoration-success="discount_variance_state == 'aligned'"/>
            </xpath>
        </field>
    </record>

</odoo>
