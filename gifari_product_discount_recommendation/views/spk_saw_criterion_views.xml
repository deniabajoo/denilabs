<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_spk_saw_criterion_tree" model="ir.ui.view">
        <field name="name">spk.saw.criterion.tree</field>
        <field name="model">spk.saw.criterion</field>
        <field name="arch" type="xml">
            <list string="SAW Criteria">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="criterion_type"/>
                <field name="weight" widget="progressbar" options="{'max_value': 100}"/>
            </list>
        </field>
    </record>

    <record id="view_spk_saw_criterion_form" model="ir.ui.view">
        <field name="name">spk.saw.criterion.form</field>
        <field name="model">spk.saw.criterion</field>
        <field name="arch" type="xml">
            <form string="SAW Criterion">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Stock Age"/></h1>
                    </div>
                    <group>
                        <group string="Identifikasi">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Konfigurasi SAW">
                            <field name="criterion_type"/>
                            <field name="weight" widget="percentpie"/>
                        </group>
                    </group>
                    <group string="Threshold Rekomendasi">
                        <field name="score_threshold_recommend"/>
                        <field name="score_threshold_high"/>
                    </group>
                    <group string="Deskripsi">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spk_saw_criterion" model="ir.actions.act_window">
        <field name="name">SAW Criteria</field>
        <field name="res_model">spk.saw.criterion</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
